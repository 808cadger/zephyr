{
  "name": "zephyr",
  "version": "2.0.0",
  "description": "The free PWA app store \u2014 install, share, discover. No gatekeeping.",
  "private": true,
  "scripts": {
    "sync": "npx cap sync android",
    "android": "cd android && ./gradlew assembleDebug",
    "build": "npm run sync && npm run android",
    "adb-install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1"
  },
  "overrides": {
    "picomatch": ">=4.0.2",
    "brace-expansion": ">=2.0.1"
  }
}